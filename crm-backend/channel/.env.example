# ── Channel service environment ────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env.

# Port the channel listens on (Render injects PORT automatically).
PORT=8001

# Shared secret. MUST match the CRM's CALLBACK_SECRET so the CRM can
# authenticate the callbacks this service sends to /api/receipts.
CALLBACK_SECRET=change-me-to-a-long-random-string
