# ── CRM backend (api) environment ──────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# Supabase Postgres connection string. Use the psycopg (v3) driver prefix.
# Example shape (from Supabase → Project Settings → Database → Connection string):
#   postgresql+psycopg://postgres:<YOUR-PASSWORD>@<HOST>:5432/postgres
# For local dev you may omit this entirely to fall back to local SQLite.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/postgres

# Groq LLM (used from Milestone 3). Get a key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Inter-service wiring
CHANNEL_SERVICE_URL=http://localhost:8001
CRM_BASE_URL=http://localhost:8000
CALLBACK_SECRET=change-me-to-a-long-random-string
