# ─── Secrets ────────────────────────────────────────────────────────────────
# Never commit real env files; .env.example IS committed (negated below).
.env
.env.*
!.env.example
api/.env
channel/.env

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
lib64/

# NOTE: the build-output `lib/` rule above is anchored with a leading slash so
# it only matches a top-level build dir — NOT the application source package
# `app/lib/` (db engine, segment compiler, etc.), which MUST be committed.
!api/app/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
.virtualenv/

# Local SQLite dev databases (fallback when no DATABASE_URL is set)
*.db
*.sqlite
*.sqlite3

# ─── Tooling / caches ───────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ─── Editor / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Scratch ────────────────────────────────────────────────────────────────
# Throwaway test/probe scripts (we used a few during development).
# NOTE: must NOT swallow dunder files like __init__.py — those are real package
# markers. The negation below re-includes every __init__.py the rule would catch.
_*.py
!__init__.py
*.log
