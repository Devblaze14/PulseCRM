# Root-level ignores for this single repo. crm-backend/ and crm-frontend/ each
# keep their own .gitignore for project-specific rules; this root file covers
# shared concerns (e.g. so a real root .env with secrets is never committed).

# ─── Secrets ────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.db
*.sqlite3
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# ─── Node / frontend ────────────────────────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
*.log

# ─── Editor / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ─── Scratch ────────────────────────────────────────────────────────────────
_*.py

# ─── Assignment Files ───────────────────────────────────────────────────────
Xeno Engineering Internship Assignment - 2026.md
Xeno Engineering Internship Assignment - 2026.pdf

