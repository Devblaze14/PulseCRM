# ── Frontend environment ────────────────────────────────────────────────────
# Copy to `.env`. Vite only exposes vars prefixed with VITE_ to the browser.

# Base URL of the CRM backend API.
#   Local dev: http://localhost:8000  (run the api service with WARP/VPN on so
#              it can reach Supabase).
#   Production: your Render API URL, e.g. https://pulsecrm-api.onrender.com
VITE_API_URL=http://localhost:8000
